# ──────────────────────────────────────────
# DevANT Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ──────────────────────────────────────────

# PostgreSQL — Your External Supabase DB (pg package only, no supabase client)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.pbervsytinmfejbmnqzu.supabase.co:5432/postgres

# Server
PORT=3001
NODE_ENV=development

# GitHub OAuth App (create at github.com/settings/developers)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# OpenAI (for AI commit analyzer)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Frontend URL(s) for CORS.
# Use a comma-separated list in FRONTEND_URL if you need more than one origin.
# Trailing slashes are fine; the server normalizes them.
FRONTEND_URL=https://your-lovable-app.lovable.app,https://dev-ant.vercel.app
